{
  "_comment": "Frame settings the website can change. Read by display.py and avian/api/frame.php; each value saved from the site overrides the same key in config.toml.",
  "device": {
    "port": 6053,
    "poll_minutes": 3,
    "_windows": "the battery frame's dawn and day windows in minutes, as birdframe-battery.yaml sets them (dawn_before, dawn_after, dusk_after)",
    "dawn_before": 60,
    "dawn_after": 120,
    "dusk_after": 30
  },
  "settings": {
    "paper_warmth": {
      "type": "float",
      "min": 0,
      "max": 0.25,
      "default": 0
    },
    "ink_saturation": {
      "type": "float",
      "min": 1,
      "max": 1.8,
      "default": 1.35
    },
    "ink_contrast": {
      "type": "float",
      "min": 1,
      "max": 1.4,
      "default": 1.12
    },
    "shoot_title": {
      "type": "string",
      "maxlen": 40,
      "default": "Avian Visitors"
    },
    "shoot_subtitle": {
      "type": "string",
      "maxlen": 40,
      "default": "Heard Today"
    },
    "check_dawn": {
      "type": "int",
      "min": 5,
      "max": 60,
      "default": 10
    },
    "check_day": {
      "type": "int",
      "min": 5,
      "max": 180,
      "default": 30
    },
    "check_night": {
      "type": "int",
      "min": 5,
      "max": 360,
      "default": 180
    },
    "device_host": {
      "type": "host",
      "maxlen": 253,
      "default": "birdframe.local"
    }
  }
}
